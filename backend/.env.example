# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=smart_campus
DB_CHARSET=UTF8MB4_0900_AI_CI

# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

UPLOAD_DIR=uploads
ATTENDANCE_ISSUE_WINDOW_DAYS=7
ATTENDANCE_MIN_PERCENT=75
# Lecturers can edit/delete a class's attendance for this many days (0 = no limit). Admins can always, with a reason.
ATTENDANCE_EDIT_WINDOW_DAYS=30
